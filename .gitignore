# ============================================================
# .gitignore for 30ghz_fmcw_frontend
# ============================================================

# --- Simulation output data (large binary) ---
*.raw

# --- LaTeX auxiliary files ---
*.aux
*.out
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bbl
*.blg

# --- OS ---
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.pyc

# --- Markdown docs (except README, VERIFICATION_STATUS, KNOWN_ISSUES) ---
complete_design_adr.md
frontend_netlists.md
engineering_journal.md
task.md
doc_src/

# --- Generated scripts ---
generate_adr.py
generate_adr_v2.py

# --- Session logs (large, not needed in repo) ---
session-*.md

# --- Editor files ---
*.swp
*.swo
*~
.vscode/
.idea/

# --- Temporary files ---
*.tmp
*.bak
